<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards">
	<description>BuddyBoss Platform dev PHP_CodeSniffer ruleset.</description>

	<file>src</file>
	<file>bp-loader.php</file>

	<!-- Exclude paths -->
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/lib/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/deprecated/*</exclude-pattern>
	<exclude-pattern>*/bboss-integrations/*</exclude-pattern>
	<exclude-pattern>*/bboss-core/classes/class-bboss-php-mailer.php</exclude-pattern>
	<exclude-pattern>*/bboss-core/classes/class-bboss-email-tokens.php</exclude-pattern>
	<exclude-pattern>*/js-templates/*</exclude-pattern>
	<exclude-pattern>awpcp_ad_listing-ajax.php</exclude-pattern>
	<exclude-pattern>*/cli/*</exclude-pattern>

	<!-- Third-party code -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<!-- Ensure certain file types aren't sniffed -->
	<exclude-pattern>*\.(css|js)</exclude-pattern>

	<arg name="colors"/>
	<arg value="p"/>

	<ini name="memory_limit" value="1024M"/>

	<!-- Configs -->

	<!-- Loads the PHP Compatibility ruleset. -->
	<rule ref="PHPCompatibilityWP" />

	<!-- PHP version check. -->
	<config name="minimum_supported_wp_version" value="4.7" />
	<config name="testVersion" value="5.6-" />

	<!-- Rules -->
	<!--
		WordPress.Files.FileName: these names are contracts, not style (2026-11-12, PROD-9562).
		- bp-forums: bbPress's own file layout (admin/admin.php, common/widgets.php, ...), kept so the
		  forum code stays diffable against bbPress.
		- bp-nouveau includes/{component}/loader.php and classes.php: the template pack includes each
		  component loader by a computed path; buddypress-functions.php is the template pack's
		  functions file, located through the template stack, and themes override it by that name.
		- readylaunch/memberpress: file names MemberPress's template lookup expects.
		- *.asset.php: dependency manifests named by @wordpress/scripts.
		- includes/Library and scoper.inc.php: generated by php-scoper / Composer.
		- libraries/wp-async-request.php: vendored WP Background Processing, upstream file name.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/bboss-forums/*</exclude-pattern>
		<exclude-pattern>*/bboss-templates/bboss-nouveau/includes/*</exclude-pattern>
		<exclude-pattern>*/bboss-templates/bboss-nouveau/buddypress-functions.php</exclude-pattern>
		<exclude-pattern>*/readylaunch/memberpress/*</exclude-pattern>
		<exclude-pattern>*.asset.php</exclude-pattern>
		<exclude-pattern>*/includes/Library/*</exclude-pattern>
		<exclude-pattern>scoper.inc.php</exclude-pattern>
		<exclude-pattern>*/bboss-core/libraries/wp-async-request.php</exclude-pattern>
	</rule>

	<rule ref="WordPress">
		<exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_query" />
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared" />
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="buddyboss" />
		</properties>
	</rule>

</ruleset>
